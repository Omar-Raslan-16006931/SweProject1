# ---------------------------------------------------------------------------
# Travel Planning and Booking Platform - environment variables (Milestone 1)
# Copy this file to backend/.env (or to .env in the repository root) and fill in the values.
# NEVER commit the real .env file (it is in .gitignore). Never paste secrets into AI tools (PDF 11.2 d).
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=3001
# Used to build absolute URLs for uploaded images
PUBLIC_BASE_URL=http://localhost:3001
# Allowed CORS origin (Next.js frontend in Milestone 2)
FRONTEND_URL=http://localhost:3000

# --- MongoDB Atlas (PDF 8.11): shared team database, connection string provided by the team leader ---
MONGODB_URI=<team-mongodb-atlas-connection-string>

# --- Auth (ACC-04, ACC-06, ACC-19) ---
# Long random strings, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access-token cookie lifetime in seconds (refresh via POST /api/auth/refresh)
JWT_ACCESS_TTL_SECONDS=900
# ACC-06: session expires after this many minutes without an authenticated request
SESSION_INACTIVITY_MINUTES=30
# httpOnly cookies are always used. Secure=true works on http://localhost in modern browsers.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Seeded administrator (ACC-18: no admin self-registration) ---
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
# At least 8 characters with at least one letter and one digit
ADMIN_PASSWORD=

# --- Stripe TEST mode (PAY-01..PAY-03) - keys from https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3001/api/payments/webhook` (local) or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# Dev-only helper endpoint POST /api/payments/:id/test-confirm (always disabled when NODE_ENV=production)
ENABLE_TEST_PAYMENT_ENDPOINT=true
# Leave empty. Only used to point the Stripe SDK at a local mock server during automated tests.
STRIPE_API_BASE=

# --- FXRatesAPI (ITN-18) - https://fxratesapi.com ---
FXRATES_API_URL=https://api.fxratesapi.com
# Optional: the free tier works without a key; if you have one it stays on the server only
FXRATES_API_KEY=

# --- Uploads (GEN-08) ---
UPLOADS_DIR=uploads

# --- Optional demo data (npm run seed:demo) ---
DEMO_PASSWORD=Demo12345
